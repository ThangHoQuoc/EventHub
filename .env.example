# ==============================================================================
# EventHub Environment Variables Template
# Sao chép file này thành .env và điền các giá trị thực tế của bạn
# Tuyệt đối KHÔNG commit file .env chứa secret thật lên Git!
# ==============================================================================

# --- 1. CHỌN MÔI TRƯỜNG KÍCH HOẠT (local | sit | uat | prod) ---
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# --- 2. CẤU HÌNH MÔI TRƯỜNG LOCAL (PostgreSQL Nội bộ / Docker) ---
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5433
LOCAL_DB_NAME=eventhub
LOCAL_DB_USER=eventhub
LOCAL_DB_PASSWORD=eventhub

# --- 3. CẤU HÌNH SUPABASE CLOUD (MÔI TRƯỜNG SIT) ---
# Lấy từ Supabase Dashboard: Project Settings -> Database -> Connection String -> Session Pooler (port 5432)
SUPABASE_SIT_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_SIT_PORT=5432
SUPABASE_SIT_DB=postgres
SUPABASE_SIT_USER=postgres.your-sit-project-ref
SUPABASE_SIT_PASSWORD=your-sit-database-password

# --- 4. CẤU HÌNH SUPABASE CLOUD (MÔI TRƯỜNG UAT / STAGING) ---
# Dự án Supabase riêng cho UAT nghiệm thu người dùng & demo hội đồng
SUPABASE_UAT_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_UAT_PORT=5432
SUPABASE_UAT_DB=postgres
SUPABASE_UAT_USER=postgres.your-uat-project-ref
SUPABASE_UAT_PASSWORD=your-uat-database-password

# --- 5. BẢO MẬT JWT AUTHENTICATION ---
# Chuỗi khóa bí mật HMAC-SHA256 (Tối thiểu 32 ký tự, mã hóa base64)
JWT_SECRET=1GoW+muYogITqBOOJ3lhB505eGlX21OaTcNNbUn/yDg=
JWT_EXPIRATION=3600000

# --- 6. CỔNG THANH TOÁN VNPAY SANDBOX ---
VNPAY_TMN_CODE=2QXUI4J4
VNPAY_HASH_SECRET=RAOCTRECEAXYZGTRJAHHAHNZGSGKTZXQ
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/result

# --- 7. DỊCH VỤ EMAIL GỬI VÉ ĐIỆN TỬ ---
APP_MAIL_ENABLED=false
APP_MAIL_FROM=no-reply@eventhub.vn
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password
SPRING_MAIL_AUTH=true
SPRING_MAIL_STARTTLS=true

# --- 8. URL FRONTEND TƯƠNG ỨNG ---
APP_FRONTEND_URL=http://localhost:5173
