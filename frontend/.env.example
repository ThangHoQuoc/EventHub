# URL API của Backend Spring Boot (để trống nếu dùng Vite dev proxy /api)
VITE_API_BASE_URL=

# Supabase Client Public Keys (nếu tích hợp Supabase Storage upload avatar/poster)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
